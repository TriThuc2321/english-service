// IELTS/TOEIC test schema – phase 1: IELTS Listening & Reading, TOEIC LR
// Tables with created_at use AuditMetadata
// (created_at, created_by_id, updated_at, updated_by_id); only created_at is listed here for brevity.
// Every timestamp (AuditMetadata as well as deadlines, submits...) is timestamptz.

Enum exam_type_enum {
  IELTS_ACADEMIC
  IELTS_GENERAL
  TOEIC_LR
  TOEIC_SW [note: 'phase 2']
}

Enum skill_enum {
  LISTENING
  READING
  WRITING  [note: 'IELTS: teacher-graded; TOEIC_SW not open yet']
  SPEAKING [note: 'IELTS: student records, teacher grades; TOEIC_SW not open yet']
}

Enum marked_by_enum {
  ALPHABET
  NUMBER
  NONE
}

Enum status_passage_enum {
  DRAFT
  PUBLISHED
  DELETED
}

Enum test_status_enum {
  DRAFT
  PUBLISHED
  DELETED
}

Enum question_type_enum {
  MULTIPLE_CHOICE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  CLASSIFICATION
  FORM_COMPLETION
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FLOW_CHART_COMPLETION
  DIAGRAM_LABELLING
  MAP_LABELLING
  PLAN_LABELLING
  SHORT_ANSWER
  PHOTO_DESCRIPTION   [note: 'TOEIC Part 1']
  QUESTION_RESPONSE   [note: 'TOEIC Part 2']
  TEXT_COMPLETION     [note: 'TOEIC Part 6']
  READ_ALOUD              [note: 'TOEIC Speaking Q1-2']
  DESCRIBE_PICTURE        [note: 'TOEIC Speaking Q3-4']
  RESPOND_TO_QUESTIONS    [note: 'TOEIC Speaking Q5-7']
  RESPOND_USING_INFO      [note: 'TOEIC Speaking Q8-10']
  EXPRESS_OPINION         [note: 'TOEIC Speaking Q11']
  WRITE_SENTENCE_PICTURE  [note: 'TOEIC Writing Q1-5']
  RESPOND_WRITTEN_REQUEST [note: 'TOEIC Writing Q6-7']
  OPINION_ESSAY           [note: 'TOEIC Writing Q8']
  IELTS_WRITING_TASK_1    [note: 'IELTS Writing Task 1, student answers {"text"}']
  IELTS_WRITING_TASK_2    [note: 'IELTS Writing Task 2, student answers {"text"}']
  IELTS_SPEAKING_PART_1   [note: 'IELTS Speaking Part 1']
  IELTS_SPEAKING_PART_2   [note: 'IELTS Speaking Part 2']
  IELTS_SPEAKING_PART_3   [note: 'IELTS Speaking Part 3']
}

Enum media_kind_enum {
  AUDIO
  IMAGE
}

Enum media_scope_enum {
  TEST
  AVATAR
  LIBRARY
  ATTEMPT [note: 'Student Speaking recordings; owner_id = attempt uuid, read through presigned URLs (not public)']
}

Enum attempt_mode_enum {
  FULL
  SECTION
}

Enum attempt_status_enum {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

Enum attempt_section_status_enum {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

Enum attempt_section_grading_status_enum {
  AUTO_GRADED [note: 'Graded automatically on submit (L/R, or a completely blank Writing -> 0)']
  PENDING     [note: 'Waiting for a teacher']
  GRADED      [note: 'Graded by a teacher, scaled_score = latest band']
}

// ───────────── Existing ─────────────

Table users {
  user_id uuid [pk]
  email varchar
  first_name varchar
  Note: 'Existing table, only a few columns listed'
}

Table passages {
  passage_id int [pk, increment]
  title varchar(255) [not null]
  subtitle varchar(255)
  marked_by marked_by_enum [not null, default: 'NONE']
  status status_passage_enum [not null, default: 'DRAFT']
  created_at timestamp

  indexes {
    status
  }
  Note: '''
  Existing table.
  A passage can't be edited/deleted while group_passages or test_parts of a locked test point to it (checked in the service).
  '''
}

Table paragraphs {
  paragraph_id int [pk, increment]
  passage_id int [not null]
  content text [not null]
  "order" int [not null, default: 0]

  indexes {
    passage_id
  }
  Note: 'Existing table'
}

// ───────────── Test structure ─────────────

Table tests {
  test_id int [pk, increment]
  exam_type exam_type_enum [not null]
  title varchar(255) [not null]
  source varchar(255) [note: 'Cambridge 18 - Test 1']
  duration_minutes int [note: 'Overall limit; TOEIC LR = 120. IELTS uses each section duration']
  status test_status_enum [not null, default: 'DRAFT']
  published_at timestamptz
  locked_at timestamptz [note: 'Set when the first attempt starts']
  created_at timestamp

  indexes {
    exam_type
    status
  }
  Note: '''
  Once locked: structural edits are blocked (section/part/group/question, question count, passage, media).
  questions.answer / explanation can still be edited to fix a wrong key -> re-grade the affected attempts.
  Since the test tree doesn't change after locking, the whole tree can be cached as JSON.
  '''
}

Table test_sections {
  section_id int [pk, increment]
  test_id int [not null]
  skill skill_enum [not null]
  "order" int [not null]
  duration_minutes int [note: 'IELTS: Listening 30 (+10 transfer), Reading 60. TOEIC: Listening 45, Reading 75 (used for SECTION practice; FULL uses tests.duration_minutes)']

  indexes {
    (test_id, skill) [unique]
  }
}

Table test_parts {
  part_id int [pk, increment]
  section_id int [not null]
  "order" int [not null]
  title varchar(255) [note: 'Part 1 / Passage 2 / TOEIC Part 5']
  instruction text
  audio_media_id int [note: 'Audio for the whole part (IELTS Listening)']
  audio_start_ms int [note: 'When several parts share one audio file']
  audio_end_ms int
  passage_id int [note: 'IELTS Reading: passage shared by every group of the part; a group with group_passages uses those instead']

  indexes {
    section_id
    passage_id
  }
}

Table question_groups {
  group_id int [pk, increment]
  part_id int [not null]
  "order" int [not null]
  question_type question_type_enum [not null]
  instruction text [note: 'Questions 1-6: Do the following statements agree...']
  word_limit int [note: 'NO MORE THAN TWO WORDS -> 2']
  content jsonb [note: '''
  Shared options (headings, features, endings, {"allowReuse":true}) /
  template with {{12}} placeholders by question number (matched against number_from, validated on publish) /
  table structure / info (TOEIC RESPOND_USING_INFO).
  Shape depends on question_type, validated in the service – see docs/question-formats.md
  ''']
  audio_media_id int [note: 'TOEIC Part 3/4 conversation audio']
  image_media_id int [note: 'Graphic TOEIC Part 3/4/7, map/plan/diagram IELTS']

  indexes {
    part_id
  }
}

Table group_passages {
  group_id int [not null]
  passage_id int [not null]
  "order" int [not null, default: 0]

  indexes {
    (group_id, passage_id) [pk]
    passage_id
  }
  Note: 'TOEIC Part 7 groups have 2-3 passages. The passages of a group = group_passages if any, otherwise test_parts.passage_id'
}

Table questions {
  question_id int [pk, increment]
  group_id int [not null]
  number_from int [not null, note: 'Displayed question number, e.g. 21']
  number_to int [not null, note: '22 for Choose TWO; equal to number_from for a normal question']
  "order" int [not null]
  prompt text
  content jsonb [note: 'Per-question options (MCQ A-D) / SW preparation-response times – see docs/question-formats.md']
  answer jsonb [not null, note: '''
  Schema per question_type (discriminated union, validated in the service – see docs/question-formats.md):
  {"key":"B"} | {"keys":["A","D"]} | {"accepted":["colour","color"]}
  Speaking/Writing (no fixed answer): {"sample":"...","rubric":{...}?} – model answer + criteria for AI/teacher grading.
  Completion: matched after normalising (trim, lowercase, strip trailing punctuation) + word_limit applied.
  NEVER return answer/explanation/evidence from the test-taking API.
  ''']
  explanation text
  evidence jsonb [note: 'Locate answer khi review: {"paragraphId":12,"quote":"..."}']
  audio_media_id int [note: 'Clip TOEIC Part 1/2']
  image_media_id int [note: 'TOEIC Part 1 photo']
  audio_start_ms int [note: 'Jump to the part of the audio holding the answer during review']

  indexes {
    group_id
  }
  Note: '''
  A question's max score = number_to - number_from + 1 (max_score = SUM, not COUNT).
  No test_id here -> validated on publish: numbers run 1..40 (IELTS) / 1..200 (TOEIC) with no gaps or duplicates.
  '''
}

Table media {
  media_id int [pk, increment]
  scope media_scope_enum [not null]
  owner_id varchar(64) [note: 'Polymorphic owner (test id, user uuid, attempt uuid...), no FK; LIBRARY has no owner']
  kind media_kind_enum [not null]
  storage_key varchar(500) [not null, unique, note: 'Storage key; URL built at response time: public, or a presigned URL for scope ATTEMPT']
  mime_type varchar(100)
  size_bytes bigint
  duration_ms int
  transcript text
  created_at timestamp

  indexes {
    (scope, owner_id)
  }
  Note: 'Cannot be edited/deleted while a locked test points to it'
}

// ───────────── Attempts & scoring ─────────────

Table attempts {
  attempt_id uuid [pk]
  user_id uuid [not null]
  test_id int [not null]
  mode attempt_mode_enum [not null]
  status attempt_status_enum [not null, default: 'IN_PROGRESS']
  started_at timestamptz [not null]
  deadline_at timestamptz [note: 'Overall deadline (TOEIC LR). IELTS uses attempt_sections deadlines']
  submitted_at timestamptz
  overall_score numeric(5,1) [note: 'TOEIC = L + R. IELTS FULL = mean of the 4 bands rounded to 0.5; null until a teacher has graded Writing and Speaking (always null for SECTION)']
  created_at timestamp

  indexes {
    (user_id, started_at) [note: 'Attempt history, sorted DESC']
    (user_id, test_id)
  }
  Note: '''
  Partial unique: UNIQUE (user_id, test_id) WHERE status = 'IN_PROGRESS' (also the index for finding the attempt in progress).
  No scheduler -> EXPIRED is handled lazily: when reading/saving and now > deadline + grace, auto-submit and grade;
  EXPIRED is final, auto-graded sections already have scores; a Writing section stays PENDING until a teacher grades it.
  L/R are graded synchronously on submit -> straight to GRADED. While a Writing section is PENDING the attempt stays SUBMITTED,
  and moves to GRADED once a teacher has graded everything (an EXPIRED attempt stays EXPIRED).
  GET /grading/queue closes up to 50 overdue attempts before returning the list.
  Only PUBLISHED tests can be started; lock with UPDATE tests SET locked_at = now() WHERE locked_at IS NULL in the same transaction.
  pg returns numeric as a string -> entities use a transformer to number.
  '''
}

Table attempt_sections {
  attempt_section_id uuid [pk]
  attempt_id uuid [not null]
  section_id int [not null]
  status attempt_section_status_enum [not null, default: 'NOT_STARTED']
  started_at timestamptz
  deadline_at timestamptz [note: 'started_at + section.duration_minutes, computed by the server']
  submitted_at timestamptz
  raw_score int
  max_score int
  scaled_score numeric(5,1) [note: 'IELTS band / TOEIC section score; Writing = teacher band, null while PENDING']
  grading_status attempt_section_grading_status_enum [note: 'null until the section is graded/queued']

  indexes {
    (attempt_id, section_id) [unique]
  }
  Note: '''
  FULL: creates every section of the test. SECTION: only the sections the user picked.
  Autosave must check the deadline of the section containing the question, and the question must belong to one of the attempt's sections
  -> looked up in the cached test tree (immutable after lock), so attempt_answers needs no attempt_section_id.
  '''
}

Table attempt_answers {
  attempt_id uuid [not null]
  question_id int [not null]
  response jsonb [note: 'User answer; Writing: {"text"}, Speaking: {"mediaId"} (recording in media, scope ATTEMPT)']
  is_correct boolean [note: 'Graded and written on submit; null if left blank']
  score int [note: '0..(number_to - number_from + 1); Choose TWO grades each key, order-insensitive']
  flagged boolean [not null, default: false]
  answered_at timestamptz

  indexes {
    (attempt_id, question_id) [pk]
    question_id [note: 'Question difficulty statistics']
  }
}

Table score_scales {
  score_scale_id int [pk, increment]
  exam_type exam_type_enum [not null]
  skill skill_enum [not null]
  test_id int [note: 'null = default scale; set = override for a specific test']
  raw_score int [not null]
  scaled_score numeric(5,1) [not null]

  indexes {
    (exam_type, skill, raw_score) [note: 'partial unique WHERE test_id IS NULL']
    (test_id, skill, raw_score) [note: 'partial unique WHERE test_id IS NOT NULL']
  }
  Note: '''
  One row per raw score (IELTS 0..40 -> band, TOEIC 0..100 -> 5..495), resolved with a single lookup, no overlapping ranges.
  Lookup: prefer the row with test_id, fall back to the default scale.
  IELTS overall: mean of the 4 skills, .25 rounds up to .5, .75 rounds up to the next whole band.
  '''
}

Table assessments {
  assessment_id uuid [pk]
  attempt_section_id uuid [not null]
  revision int [not null, note: 'Starts at 1, the server increments it; the client sends expectedRevision, mismatch -> 409 ASSESSMENT_REVISION_CONFLICT']
  grader_id uuid [not null]
  band numeric(3,1) [not null, note: 'Section band (Writing: (task1 + 2*task2)/3 rounded to 0.5)']
  details jsonb [not null, note: '{"entries":[{"partId":12,"criteria":{"TA":7,"CC":6.5,"LR":7,"GRA":6},"band":6.5,"feedback":"..."}]}']
  created_at timestamptz

  indexes {
    (attempt_section_id, revision) [unique]
  }
  Note: 'Append-only: every grade/correction is a new revision. Students only see the latest revision and never the grader.'
}

// ───────────── Relations ─────────────

Ref: paragraphs.passage_id > passages.passage_id [delete: cascade]

Ref: test_sections.test_id > tests.test_id [delete: cascade]
Ref: test_parts.section_id > test_sections.section_id [delete: cascade]
Ref: question_groups.part_id > test_parts.part_id [delete: cascade]
Ref: questions.group_id > question_groups.group_id [delete: cascade]

Ref: group_passages.group_id > question_groups.group_id [delete: cascade]
Ref: group_passages.passage_id > passages.passage_id [delete: restrict]
Ref: test_parts.passage_id > passages.passage_id [delete: restrict]

Ref: test_parts.audio_media_id > media.media_id [delete: restrict]
Ref: question_groups.audio_media_id > media.media_id [delete: restrict]
Ref: question_groups.image_media_id > media.media_id [delete: restrict]
Ref: questions.audio_media_id > media.media_id [delete: restrict]
Ref: questions.image_media_id > media.media_id [delete: restrict]

Ref: attempts.user_id > users.user_id
Ref: attempts.test_id > tests.test_id
Ref: attempt_sections.attempt_id > attempts.attempt_id [delete: cascade]
Ref: attempt_sections.section_id > test_sections.section_id
Ref: attempt_answers.attempt_id > attempts.attempt_id [delete: cascade]
Ref: attempt_answers.question_id > questions.question_id

Ref: score_scales.test_id > tests.test_id [delete: cascade]

Ref: assessments.attempt_section_id > attempt_sections.attempt_section_id [delete: cascade]
Ref: assessments.grader_id > users.user_id

// ───────────── Groups (coloured on dbdiagram) ─────────────

TableGroup test_structure {
  tests
  test_sections
  test_parts
  question_groups
  questions
  group_passages
  media
}

TableGroup content_existing {
  passages
  paragraphs
  users
}

TableGroup attempts_scoring {
  attempts
  attempt_sections
  attempt_answers
  score_scales
  assessments
}
