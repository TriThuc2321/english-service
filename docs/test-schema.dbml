// IELTS/TOEIC test schema – phase 1: IELTS Listening & Reading, TOEIC LR
// Bảng nào có created_at là bảng dùng AuditMetadata
// (created_at, created_by_id, updated_at, updated_by_id), ở đây chỉ ghi created_at cho gọn.
// Mọi mốc thời gian (AuditMetadata lẫn deadline, submit...) đều là timestamptz.

Enum exam_type_enum {
  IELTS_ACADEMIC
  IELTS_GENERAL
  TOEIC_LR
  TOEIC_SW [note: 'phase 2']
}

Enum skill_enum {
  LISTENING
  READING
  WRITING  [note: 'IELTS: giáo viên chấm; TOEIC_SW chưa mở']
  SPEAKING [note: 'IELTS: học sinh ghi âm, giáo viên chấm; TOEIC_SW chưa mở']
}

Enum marked_by_enum {
  ALPHABET
  NUMBER
  NONE
}

Enum status_passage_enum {
  DRAFT
  PUBLISHED
  DELETED
}

Enum test_status_enum {
  DRAFT
  PUBLISHED
  DELETED
}

Enum question_type_enum {
  MULTIPLE_CHOICE
  MULTIPLE_CHOICE_MULTI
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  CLASSIFICATION
  FORM_COMPLETION
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  NOTE_COMPLETION
  TABLE_COMPLETION
  FLOW_CHART_COMPLETION
  DIAGRAM_LABELLING
  MAP_LABELLING
  PLAN_LABELLING
  SHORT_ANSWER
  PHOTO_DESCRIPTION   [note: 'TOEIC Part 1']
  QUESTION_RESPONSE   [note: 'TOEIC Part 2']
  TEXT_COMPLETION     [note: 'TOEIC Part 6']
  READ_ALOUD              [note: 'TOEIC Speaking Q1-2']
  DESCRIBE_PICTURE        [note: 'TOEIC Speaking Q3-4']
  RESPOND_TO_QUESTIONS    [note: 'TOEIC Speaking Q5-7']
  RESPOND_USING_INFO      [note: 'TOEIC Speaking Q8-10']
  EXPRESS_OPINION         [note: 'TOEIC Speaking Q11']
  WRITE_SENTENCE_PICTURE  [note: 'TOEIC Writing Q1-5']
  RESPOND_WRITTEN_REQUEST [note: 'TOEIC Writing Q6-7']
  OPINION_ESSAY           [note: 'TOEIC Writing Q8']
  IELTS_WRITING_TASK_1    [note: 'IELTS Writing Task 1, học sinh trả lời {"text"}']
  IELTS_WRITING_TASK_2    [note: 'IELTS Writing Task 2, học sinh trả lời {"text"}']
  IELTS_SPEAKING_PART_1   [note: 'IELTS Speaking Part 1']
  IELTS_SPEAKING_PART_2   [note: 'IELTS Speaking Part 2']
  IELTS_SPEAKING_PART_3   [note: 'IELTS Speaking Part 3']
}

Enum media_kind_enum {
  AUDIO
  IMAGE
}

Enum media_scope_enum {
  TEST
  AVATAR
  LIBRARY
  ATTEMPT [note: 'Bản ghi âm Speaking của học sinh; owner_id = attempt uuid, đọc qua URL ký sẵn (không public)']
}

Enum attempt_mode_enum {
  FULL
  SECTION
}

Enum attempt_status_enum {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

Enum attempt_section_status_enum {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

Enum attempt_section_grading_status_enum {
  AUTO_GRADED [note: 'Chấm tự động lúc nộp (L/R, hoặc Writing bỏ trống hoàn toàn -> 0)']
  PENDING     [note: 'Chờ giáo viên chấm']
  GRADED      [note: 'Giáo viên đã chấm, scaled_score = band mới nhất']
}

// ───────────── Existing ─────────────

Table users {
  user_id uuid [pk]
  email varchar
  first_name varchar
  Note: 'Bảng có sẵn, chỉ ghi vài cột'
}

Table passages {
  passage_id int [pk, increment]
  title varchar(255) [not null]
  subtitle varchar(255)
  marked_by marked_by_enum [not null, default: 'NONE']
  status status_passage_enum [not null, default: 'DRAFT']
  created_at timestamp

  indexes {
    status
  }
  Note: '''
  Bảng có sẵn.
  Không cho sửa/xoá passage khi đang được group_passages hoặc test_parts của một test đã locked trỏ tới (check ở service).
  '''
}

Table paragraphs {
  paragraph_id int [pk, increment]
  passage_id int [not null]
  content text [not null]
  "order" int [not null, default: 0]

  indexes {
    passage_id
  }
  Note: 'Bảng có sẵn'
}

// ───────────── Test structure ─────────────

Table tests {
  test_id int [pk, increment]
  exam_type exam_type_enum [not null]
  title varchar(255) [not null]
  source varchar(255) [note: 'Cambridge 18 - Test 1']
  duration_minutes int [note: 'Hạn tổng; TOEIC LR = 120. IELTS dùng duration của từng section']
  status test_status_enum [not null, default: 'DRAFT']
  published_at timestamptz
  locked_at timestamptz [note: 'Ghi khi có attempt đầu tiên']
  created_at timestamp

  indexes {
    exam_type
    status
  }
  Note: '''
  Sau khi locked: chặn sửa cấu trúc (section/part/group/question, số câu, passage, media).
  Vẫn cho sửa questions.answer / explanation để fix đáp án sai -> re-grade các attempt liên quan.
  Vì cây test không đổi sau khi lock, có thể cache JSON cả cây.
  '''
}

Table test_sections {
  section_id int [pk, increment]
  test_id int [not null]
  skill skill_enum [not null]
  "order" int [not null]
  duration_minutes int [note: 'IELTS: Listening 30 (+10 transfer), Reading 60. TOEIC: Listening 45, Reading 75 (dùng khi luyện SECTION; FULL dùng tests.duration_minutes)']

  indexes {
    (test_id, skill) [unique]
  }
}

Table test_parts {
  part_id int [pk, increment]
  section_id int [not null]
  "order" int [not null]
  title varchar(255) [note: 'Part 1 / Passage 2 / TOEIC Part 5']
  instruction text
  audio_media_id int [note: 'Audio của cả part (IELTS Listening)']
  audio_start_ms int [note: 'Khi nhiều part dùng chung một file audio']
  audio_end_ms int
  passage_id int [note: 'IELTS Reading: passage dùng chung cho mọi group của part; group có group_passages thì ưu tiên group_passages']

  indexes {
    section_id
    passage_id
  }
}

Table question_groups {
  group_id int [pk, increment]
  part_id int [not null]
  "order" int [not null]
  question_type question_type_enum [not null]
  instruction text [note: 'Questions 1-6: Do the following statements agree...']
  word_limit int [note: 'NO MORE THAN TWO WORDS -> 2']
  content jsonb [note: '''
  Shared options (headings, features, endings, {"allowReuse":true}) /
  template có placeholder {{12}} theo số câu (khớp number_from validate lúc publish) /
  table structure / info (TOEIC RESPOND_USING_INFO).
  Shape theo question_type, validate ở service – xem docs/question-formats.md
  ''']
  audio_media_id int [note: 'Audio hội thoại TOEIC Part 3/4']
  image_media_id int [note: 'Graphic TOEIC Part 3/4/7, map/plan/diagram IELTS']

  indexes {
    part_id
  }
}

Table group_passages {
  group_id int [not null]
  passage_id int [not null]
  "order" int [not null, default: 0]

  indexes {
    (group_id, passage_id) [pk]
    passage_id
  }
  Note: 'TOEIC Part 7 có group gồm 2-3 passage. Passage của group = group_passages nếu có, không thì test_parts.passage_id'
}

Table questions {
  question_id int [pk, increment]
  group_id int [not null]
  number_from int [not null, note: 'Số câu hiển thị, vd 21']
  number_to int [not null, note: '22 nếu là Choose TWO; bằng number_from nếu câu thường']
  "order" int [not null]
  prompt text
  content jsonb [note: 'Options riêng của câu (MCQ A-D) / thời gian chuẩn bị-trả lời SW – xem docs/question-formats.md']
  answer jsonb [not null, note: '''
  Schema theo question_type (discriminated union, validate ở service – xem docs/question-formats.md):
  {"key":"B"} | {"keys":["A","D"]} | {"accepted":["colour","color"]}
  Speaking/Writing (không có đáp án cố định): {"sample":"...","rubric":{...}?} – bài mẫu + tiêu chí cho AI/giáo viên chấm.
  Completion: so khớp sau khi normalize (trim, lowercase, bỏ dấu câu cuối) + áp word_limit.
  KHÔNG bao giờ trả answer/explanation/evidence trong API làm bài.
  ''']
  explanation text
  evidence jsonb [note: 'Locate answer khi review: {"paragraphId":12,"quote":"..."}']
  audio_media_id int [note: 'Clip TOEIC Part 1/2']
  image_media_id int [note: 'Ảnh TOEIC Part 1']
  audio_start_ms int [note: 'Nhảy tới đoạn chứa đáp án khi review']

  indexes {
    group_id
  }
  Note: '''
  Điểm tối đa của câu = number_to - number_from + 1 (max_score = SUM, không phải COUNT).
  Không có test_id ở đây -> validate lúc publish: số câu liên tục 1..40 (IELTS) / 1..200 (TOEIC), không trùng.
  '''
}

Table media {
  media_id int [pk, increment]
  scope media_scope_enum [not null]
  owner_id varchar(64) [note: 'Owner đa hình (test id, user uuid, attempt uuid...), không có FK; LIBRARY không có owner']
  kind media_kind_enum [not null]
  storage_key varchar(500) [not null, unique, note: 'Key trong storage; URL build lúc trả về: public, hoặc URL ký sẵn cho scope ATTEMPT']
  mime_type varchar(100)
  size_bytes bigint
  duration_ms int
  transcript text
  created_at timestamp

  indexes {
    (scope, owner_id)
  }
  Note: 'Không cho sửa/xoá khi đang được test đã locked trỏ tới'
}

// ───────────── Attempts & scoring ─────────────

Table attempts {
  attempt_id uuid [pk]
  user_id uuid [not null]
  test_id int [not null]
  mode attempt_mode_enum [not null]
  status attempt_status_enum [not null, default: 'IN_PROGRESS']
  started_at timestamptz [not null]
  deadline_at timestamptz [note: 'Hạn tổng (TOEIC LR). IELTS dùng deadline của attempt_sections']
  submitted_at timestamptz
  overall_score numeric(5,1) [note: 'TOEIC = L + R. IELTS FULL = trung bình 4 band làm tròn 0.5; null cho tới khi giáo viên chấm xong Writing và Speaking (SECTION luôn null)']
  created_at timestamp

  indexes {
    (user_id, started_at) [note: 'Lịch sử làm bài, sort DESC']
    (user_id, test_id)
  }
  Note: '''
  Partial unique: UNIQUE (user_id, test_id) WHERE status = 'IN_PROGRESS' (cũng là index tìm attempt đang làm).
  Không có scheduler -> EXPIRED xử lý lazy: khi đọc/lưu mà now > deadline + grace thì auto-submit và chấm;
  EXPIRED là trạng thái cuối, các section tự chấm đã có điểm; section Writing vẫn PENDING cho đến khi giáo viên chấm.
  L/R chấm đồng bộ lúc nộp -> đi thẳng GRADED. Còn section Writing PENDING thì attempt dừng ở SUBMITTED,
  khi giáo viên chấm hết thì sang GRADED (attempt đã EXPIRED thì giữ EXPIRED).
  GET /grading/queue đóng tối đa 50 attempt quá hạn trước khi trả danh sách.
  Chỉ start trên test PUBLISHED; lock bằng UPDATE tests SET locked_at = now() WHERE locked_at IS NULL trong cùng transaction.
  numeric trả về string từ pg -> entity dùng transformer sang number.
  '''
}

Table attempt_sections {
  attempt_section_id uuid [pk]
  attempt_id uuid [not null]
  section_id int [not null]
  status attempt_section_status_enum [not null, default: 'NOT_STARTED']
  started_at timestamptz
  deadline_at timestamptz [note: 'started_at + section.duration_minutes, server tính']
  submitted_at timestamptz
  raw_score int
  max_score int
  scaled_score numeric(5,1) [note: 'IELTS band / TOEIC section score; Writing = band của giáo viên, null khi PENDING']
  grading_status attempt_section_grading_status_enum [note: 'null cho tới khi section được chấm/đưa vào hàng chờ']

  indexes {
    (attempt_id, section_id) [unique]
  }
  Note: '''
  FULL: tạo đủ các section của test. SECTION: chỉ tạo section user chọn.
  Autosave answer phải check deadline của section chứa câu hỏi, và câu hỏi phải thuộc một section của attempt
  -> tra bằng cây test đã cache (không đổi sau lock), nên attempt_answers không cần attempt_section_id.
  '''
}

Table attempt_answers {
  attempt_id uuid [not null]
  question_id int [not null]
  response jsonb [note: 'Đáp án user; Writing: {"text"}, Speaking: {"mediaId"} (bản ghi âm trong media, scope ATTEMPT)']
  is_correct boolean [note: 'Chấm và ghi lúc nộp; null nếu bỏ trống']
  score int [note: '0..(number_to - number_from + 1); Choose TWO chấm từng key, không xét thứ tự']
  flagged boolean [not null, default: false]
  answered_at timestamptz

  indexes {
    (attempt_id, question_id) [pk]
    question_id [note: 'Thống kê độ khó câu hỏi']
  }
}

Table score_scales {
  score_scale_id int [pk, increment]
  exam_type exam_type_enum [not null]
  skill skill_enum [not null]
  test_id int [note: 'null = thang mặc định; có giá trị = override cho đề cụ thể']
  raw_score int [not null]
  scaled_score numeric(5,1) [not null]

  indexes {
    (exam_type, skill, raw_score) [note: 'partial unique WHERE test_id IS NULL']
    (test_id, skill, raw_score) [note: 'partial unique WHERE test_id IS NOT NULL']
  }
  Note: '''
  Mỗi raw score một dòng (IELTS 0..40 -> band, TOEIC 0..100 -> 5..495), tra bằng một lookup, không chồng range.
  Lookup: ưu tiên dòng có test_id, fallback thang mặc định.
  IELTS overall: trung bình 4 kỹ năng, .25 làm tròn lên .5, .75 làm tròn lên số nguyên.
  '''
}

Table assessments {
  assessment_id uuid [pk]
  attempt_section_id uuid [not null]
  revision int [not null, note: 'Bắt đầu từ 1, server tăng thêm 1; client gửi expectedRevision, lệch -> 409 ASSESSMENT_REVISION_CONFLICT']
  grader_id uuid [not null]
  band numeric(3,1) [not null, note: 'Band của section (Writing: (task1 + 2*task2)/3 làm tròn 0.5)']
  details jsonb [not null, note: '{"entries":[{"partId":12,"criteria":{"TA":7,"CC":6.5,"LR":7,"GRA":6},"band":6.5,"feedback":"..."}]}']
  created_at timestamptz

  indexes {
    (attempt_section_id, revision) [unique]
  }
  Note: 'Append-only: mỗi lần chấm/sửa là một revision mới. Học sinh chỉ thấy revision mới nhất, không thấy grader.'
}

// ───────────── Relations ─────────────

Ref: paragraphs.passage_id > passages.passage_id [delete: cascade]

Ref: test_sections.test_id > tests.test_id [delete: cascade]
Ref: test_parts.section_id > test_sections.section_id [delete: cascade]
Ref: question_groups.part_id > test_parts.part_id [delete: cascade]
Ref: questions.group_id > question_groups.group_id [delete: cascade]

Ref: group_passages.group_id > question_groups.group_id [delete: cascade]
Ref: group_passages.passage_id > passages.passage_id [delete: restrict]
Ref: test_parts.passage_id > passages.passage_id [delete: restrict]

Ref: test_parts.audio_media_id > media.media_id [delete: restrict]
Ref: question_groups.audio_media_id > media.media_id [delete: restrict]
Ref: question_groups.image_media_id > media.media_id [delete: restrict]
Ref: questions.audio_media_id > media.media_id [delete: restrict]
Ref: questions.image_media_id > media.media_id [delete: restrict]

Ref: attempts.user_id > users.user_id
Ref: attempts.test_id > tests.test_id
Ref: attempt_sections.attempt_id > attempts.attempt_id [delete: cascade]
Ref: attempt_sections.section_id > test_sections.section_id
Ref: attempt_answers.attempt_id > attempts.attempt_id [delete: cascade]
Ref: attempt_answers.question_id > questions.question_id

Ref: score_scales.test_id > tests.test_id [delete: cascade]

Ref: assessments.attempt_section_id > attempt_sections.attempt_section_id [delete: cascade]
Ref: assessments.grader_id > users.user_id

// ───────────── Groups (tô màu trên dbdiagram) ─────────────

TableGroup test_structure {
  tests
  test_sections
  test_parts
  question_groups
  questions
  group_passages
  media
}

TableGroup content_existing {
  passages
  paragraphs
  users
}

TableGroup attempts_scoring {
  attempts
  attempt_sections
  attempt_answers
  score_scales
  assessments
}
