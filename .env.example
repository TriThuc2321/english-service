APP_PORT=8080

# Postgres Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SYNC=true
DATABASE_SSL=false

# Google Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_LOGIN_REDIRECT_URL_WEB=
GOOGLE_LOGIN_REDIRECT_URL_BO=

# HTTPS (optional, falls back to HTTP)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_LOCAL_DOMAIN=

# Express "trust proxy" (hop count, or comma-separated IPs/CIDRs/keywords
# like "loopback"). Must cover the student BFF server and any load balancer.
TRUST_PROXY=

# Cors (comma-separated)
CORS_ORIGINS=

# JWT (secrets must be >= 32 chars)
JWT_SECRET=
JWT_SECRET_REFRESH=
JWT_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=7d

# Storage (Cloudflare R2, S3-compatible)
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_UPLOAD_URL_TTL=600
# Custom domain connected to the bucket, e.g. https://media.myenglish.com
STORAGE_PUBLIC_URL=